{
  "name": "desktop-pet-workflow",
  "version": "0.1.0",
  "private": true,
  "description": "Offline, package-driven desktop pet runtime",
  "main": "src/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "node scripts/source-preflight.js && electron .",
    "pet": "node scripts/source-preflight.js && node scripts/start-pet.js",
    "source:preflight": "node scripts/source-preflight.js",
    "import-pet": "node scripts/import-pet.js",
    "build-pet": "node scripts/build-pet.js",
    "verify-mac-candidate": "node scripts/verify-mac-candidate.js",
    "test": "node --test test/*.test.js",
    "lint": "node scripts/check-syntax.js"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "yauzl": "3.4.0"
  }
}
