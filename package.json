{
  "name": "pet-studio-lite",
  "version": "0.1.0",
  "description": "Pet Studio Lite — 宠物包导入/检查/预览/配置/导出 Windows 便携桌宠",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:pet": "electron-vite build --config electron.vite.pet.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:petpack && npm run test:zip && npm run test:runtime",
    "test:petpack": "esbuild scripts/test-petpack.mts --bundle --platform=node --format=esm --target=node20 --outfile=scripts/test-petpack.bundle.mjs --packages=external && node scripts/test-petpack.bundle.mjs",
    "test:zip": "esbuild scripts/test-zip.mts --bundle --platform=node --format=esm --target=node20 --outfile=scripts/test-zip.bundle.mjs --packages=external && node scripts/test-zip.bundle.mjs",
    "test:runtime": "esbuild scripts/test-runtime.mts --bundle --platform=node --format=esm --target=node20 --outfile=scripts/test-runtime.bundle.mjs --packages=external && node scripts/test-runtime.bundle.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "check:export": "node scripts/check-export.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
