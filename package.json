{
  "name": "desktop-pet-workflow",
  "version": "0.1.0",
  "private": true,
  "description": "Offline, package-driven desktop pet runtime",
  "main": "src/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "node scripts/source-preflight.js && electron .",
    "pet": "node scripts/source-preflight.js && node scripts/start-pet.js",
    "studio": "npm run studio:build && node scripts/source-preflight.js && electron src/workbench/main.js",
    "studio:build": "vite build --config vite.workbench.config.mjs",
    "studio:package": "npm run studio:build && node scripts/build-studio.js",
    "studio:typecheck": "tsc -p tsconfig.workbench.json --noEmit",
    "source:preflight": "node scripts/source-preflight.js",
    "import-pet": "node scripts/import-pet.js",
    "build-pet": "node scripts/build-pet.js",
    "verify-mac-candidate": "node scripts/verify-mac-candidate.js",
    "diagnostics:legacy-instance-lock": "node --test diagnostics/instance-lock/legacy-instance-lock.test.js && node diagnostics/instance-lock/protocol-probe.js",
    "test": "node --test test/*.test.js",
    "lint": "node scripts/check-syntax.js"
  },
  "devDependencies": {
    "electron-builder": "26.15.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "43.4.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "dependencies": {
    "@electron/asar": "^3.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yauzl": "3.4.0"
  }
}
